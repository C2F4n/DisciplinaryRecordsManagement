# Copy to .env in the directory containing pom.xml. Do not commit .env.
DB_USER=discipline_app
DB_PASSWORD=

# Set these for the first startup only, if the database has no administrator.
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=

# SMTP fallback until saved under 系统管理 → SMTP 配置.
# Keep the automatically generated .smtp-settings.key when moving the server.
APP_NOTICE_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false
