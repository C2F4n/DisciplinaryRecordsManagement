# =============================================================================
# 违纪统计系统 · 启动配置模板（唯一模板，其他文档以此为准）
# =============================================================================
# 用法：复制为 .env，放在与 JAR（或 pom.xml）同一目录。启动系统.cmd 会自动
#       切换到该目录再启动，所以相对路径都以此为基准。
# 生效：改完必须重启进程。/.env 已在 .gitignore 中，不要提交、不要外传。
# 语法：按 .properties 解析。值一律用 ASCII、不加引号；中文只能写在注释里。
# 必填：只有第 1 段。其余留空即使用程序内置默认值。
# =============================================================================

# --- 1. 数据库（必填，须与 MySQL 中创建的账号完全一致）------------------------
# 库名/端口与这里不一致时，登录会直接失败；time-zone 与 APP_TIME_ZONE 保持一致。
DB_URL=jdbc:mysql://127.0.0.1:3306/disciplinary_records?connectionTimeZone=Asia/Shanghai
DB_USER=discipline_app
DB_PASSWORD=

# --- 2. 网页管理员（只在库中还没有核心管理员时生效，之后可留空）---------------
# 登录名：小写字母开头，4–48 位，允许 a-z 0-9 _ . -
# 密码：6–18 位，至少一个字母和一个数字，只允许 A-Z a-z 0-9 _ @
# 写成六位纯数字时按「临时密码」处理：24 小时有效，且要求仅监听本机。
#
# ！！注意：空库首次启动时如果 APP_ADMIN_PASSWORD 留空，程序不会创建任何管理员，
# ！！      结果是谁都登录不进去（登录页只会提示「用户名或密码不正确」）。
# ！！      所以这个值必须在第一次启动之前就填好，改完要重启程序才会生效。
# ！！      如果库不是空的（例如从旧机器导入），这两行会被忽略——此时要用
# ！！      数据库里原有的管理员，或运行 重置管理员密码.ps1 重设。
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=

# --- 3. 本机 HTTPS（部署包自带 .https/server.p12，通常保持原样）----------------
# key-store 是相对工作目录的路径，必须用 启动系统.cmd 启动。
# 若改为 enabled=false，必须同时把 SESSION_COOKIE_SECURE 改为 false，
# 否则浏览器不回传会话 Cookie，表现为登录成功后又跳回登录页。
server.ssl.enabled=true
server.ssl.key-store=file:./.https/server.p12
server.ssl.key-store-type=PKCS12
server.ssl.key-store-password=
server.ssl.key-alias=disciplinary-localhost
SESSION_COOKIE_SECURE=true

# --- 4. 端口与监听（留空即 18643 / 仅本机）------------------------------------
# 同网段其他电脑要访问时，取消注释并把 BIND_ADDRESS 改成 0.0.0.0。
# 注意：非本机监听时，六位纯数字的临时初始密码会被拒绝（安全限制）。
# APP_PORT=18643
# BIND_ADDRESS=127.0.0.1

# --- 5. 时区与业务期限（留空即下列默认值）-------------------------------------
# APP_TIME_ZONE=Asia/Shanghai
# APP_PENDING_DAYS=4
# APP_EDIT_DAYS=2
# APP_ENROLLMENT_YEARS=4

# --- 6. SMTP 兜底（留空；正常在「系统管理 → SMTP 配置」页面保存）---------------
# 页面保存的配置优先于这里，本段仅用于首次启动前就要发信的场合。
# .smtp-settings.key 是后台保存授权码时自动生成的解密密钥，迁移机器要一起带走。
# APP_NOTICE_EMAIL_ENABLED=false
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_STARTTLS=true
# SMTP_SSL=false

# --- 7. 记录清理（留空即关闭）--------------------------------------------------
# APP_RETENTION_ENABLED=false
# APP_RETENTION_YEARS=1
